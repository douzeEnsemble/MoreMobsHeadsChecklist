{
  "name": "more-mob-heads-checklist",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:arch",
    "lint:js": "eslint .",
    "lint:css": "stylelint style.css",
    "lint:arch": "depcruise js scripts",
    "lint:html": "html-validate index.html",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "jsdom": "^31.0.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "vitest": "^5.1.1"
  }
}
